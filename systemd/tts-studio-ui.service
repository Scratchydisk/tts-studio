[Unit]
Description=TTS Studio Web UI
After=network.target

[Service]
Type=simple
User=stewart
WorkingDirectory=/home/stewart/tts-studio
ExecStart=/home/stewart/tts-studio/venv/bin/tts-studio serve
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID

[Install]
WantedBy=multi-user.target
